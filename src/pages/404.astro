---
import Layout from "../layouts/Layout.astro";

// ヘッダーに表示されるナビゲーション項目を想定
const navigationLinks = [
  { href: "/", label: "ホーム" },
  { href: "/practice", label: "練習" },
  { href: "/braille-table", label: "点字一覧表" },
  // { href: "/about", label: "このアプリについて" },
  // { href: "/faq", label: "よくある質問" },
  // { href: '/settings', label: '設定' },
];
---

<Layout title="404: ページが見つかりません - 指点字アプリ">
  <main>
    <div class="error-container">
      <span class="error-code">404</span>
      <h1 class="error-heading">お探しのページは見つかりません。</h1>
      <p class="error-message">
        お探しのページは、存在しないようです。
        <br class="mobile-break" />
        URLに間違いがないかご確認ください。
      </p>

      <hr />

      <div class="guidance-section">
        <h2>下記のページとお間違いではないでしょうか。</h2>
        <p>よくアクセスされているページです。</p>
        <ul class="guidance-list">
          {
            navigationLinks.map((link) => (
              <li>
                <a href={link.href} class="guidance-link">
                  <span class="icon">➜</span> {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="faq-section">
        <h3>ここにたどり着いた理由</h3>
        <p class="faq-answer">
          スペルミスの修正などによりURLが変更になった可能性。ブックマークが古くなっている。
          不具合が見つかったため、更新のためにページを消しているなどの可能性があります。
          ホームに戻り、表示されているリンク内に目当てのページがないかもご確認くださいませ。
        </p>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* ページの構造 */
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 60px 20px;
    min-height: calc(100vh - var(--header-height));
    background-color: var(--color-bg);
  }

  /* エラーコンテナ */
  .error-container {
    width: 100%;
    max-width: 600px;
    padding: 30px;
    background-color: var(--color-bg);
    border-radius: var(--border-radius-lg);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    text-align: center;
  }

  /* エラーコード */
  .error-code {
    display: block;
    font-size: 5rem;
    font-weight: var(--font-weight-black);
    color: var(--text-red);
    opacity: 0.85;
    line-height: 1;
    margin-bottom: 5px;
  }

  /* 見出しとメッセージ */
  .error-heading {
    font-size: 2rem;
    color: var(--color-text);
    margin-top: 0;
    margin-bottom: 20px;
  }
  .error-message {
    font-size: 1.1rem;
    color: var(--color-darkgray);
    line-height: 1.6;
  }

  hr {
    border: none;
    border-top: 1px solid #eee;
    margin: 30px 0;
  }

  /* 誘導セクション */
  .guidance-section h2 {
    font-size: 1.3rem;
    color: var(--color-primary); /* ブランドカラーを使用 */
    margin-top: 0;
    margin-bottom: 0.25rem;
  }

  .guidance-list {
    padding: 0;
    margin-bottom: 30px;
  }

  .guidance-list li {
    margin: 10px 0;
  }

  .guidance-link {
    display: inline-flex;
    align-items: center;
    padding: 10px 15px;
    background-color: var(--color-paleblue);
    color: var(--color-primary);
    text-decoration: none;
    border-radius: var(--border-radius-md);
    transition: all 0.2s ease;
    font-weight: var(--font-weight-semi-bold);
    border: 1px solid var(--color-aqua);
  }

  .guidance-link:hover {
    background-color: var(--color-primary);
    color: white;
    box-shadow: 0 4px 8px rgba(0, 123, 255, 0.2);
  }

  .icon {
    font-size: 1.2rem;
    margin-right: 10px;
  }

  /* FAQセクション */
  .faq-section {
    padding-top: 15px;
    border-top: 1px dashed #e0e0e0;
    text-align: left;
  }

  .faq-section h3 {
    font-size: 1rem;
    color: var(--color-text-gray);
    margin-bottom: 5px;
    font-weight: var(--font-weight-semi-bold);
  }

  .faq-answer {
    font-size: 0.9rem;
    color: var(--color-text-gray);
    margin: 0;
  }

  /* SP */
  @media (width <= 500px) {
    .error-code {
      font-size: 4rem;
    }
    .error-heading {
      font-size: 1.5rem;
    }
    .guidance-link {
      width: 100%;
      justify-content: center;
    }
  }
</style>
