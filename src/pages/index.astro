---
import Layout from "../layouts/Layout.astro";
import keyboardPlacement from "../assets/keyboard-placement.svg";
---

<Layout title="ホーム｜指点字練習アプリ">
  <main class="top-page-main">
    <h1>指点字練習アプリ</h1>
    <div>
      <p>
        指点字（ゆびてんじ）の入力を練習するための Web アプリケーションです。<br
        />
        キーボードを使って、指点字の基本を学びましょう。
      </p>
      <p>
        指をホームポジションに置いた時の、人差し指、中指、薬指を使います。<br />
        左の人差し指をFキー、右手の人差し指をJキーに置きます。
      </p>
    </div>
    <img src={keyboardPlacement.src} alt="イラスト。指の配置" />

    <nav class="main-nav">
      <a href="/practice" class="btn-primary"> 練習を始める → </a>
    </nav>
  </main>

  <style>
    .top-page-main {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: start;
      text-align: center;
      padding: 4rem 2rem;
      max-width: 800px;
      width: width: fit-content;
      margin: auto;
      min-height: 100vh;
    }

    h1 {
      font-size: 2.5rem;
      color: var(--color-text);
      margin-bottom: 1rem;
    }

    .top-page-main p {
      color: var(--color-darkgray);
      line-height: 1.6;
      text-align: left;
      width: 100%;
      max-width: 600px;
    }

    .top-page-main img {
      width: 100%;
      max-width: 400px;
      height: auto;
    }

    .main-nav {
      margin-top: 3rem;
    }
  </style>
</Layout>
