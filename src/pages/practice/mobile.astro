---
import Layout from "../../layouts/Layout.astro";
import MobileBrailleApp from "../../components/BrailleApp/MobileBrailleApp.tsx";
---

<Layout title="スマホ練習｜指点字練習アプリ">
  <main>
    <MobileBrailleApp client:only="react" />
  </main>

  <style>
    main {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 1.5rem 1rem;
      touch-action: manipulation;
    }
  </style>
</Layout>
