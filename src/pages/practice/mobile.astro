---
import Layout from "../../layouts/Layout.astro";
import MobileBrailleApp from "../../components/BrailleApp/MobileBrailleApp.tsx";
---

<Layout title="指点字練習(スマホ版)｜指点字練習アプリ" isMobileHeader={true}>
  <main>
    <MobileBrailleApp client:only="react" />
  </main>

  <style>
    main {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 1.5rem 1rem;
      touch-action: manipulation;
    }

    @media screen and (orientation: landscape) {
      main {
        padding-top: 0;
      }
    }
  </style>
</Layout>
